<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- アプリ自身は通信しない。INTERNET は課金ライブラリの依存
         （datatransport）からマニフェスト統合で入ってくるため、鏡と同じく
         明示的に除去する。購入の通信は Play ストアアプリが行うので影響しない -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- 歩数センサー(TYPE_STEP_COUNTER)の読み取りに必須のランタイム権限 -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- 計測が止まっていることを知らせるため。拒否されても記録自体は動く -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 端末再起動後に WorkManager を組み直し、センサーの基準値を打ち直すため -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 歩数センサーを常駐して受け取るため。バックグラウンドからはセンサーを読めない
         （OS の sensor access restriction）ので health 型の Foreground Service で動かす -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- Health Connect から読むのは歩数・体重・睡眠の中核3種だけ
         （Play 公開に向けた本人の決定、2026-11-21）。
         心拍・血圧・体脂肪率などの保留中機能の権限は外した。
         読み取り側は種類ごとに権限を確認し、無ければ空を返すので、
         権限が無い前提でも歩数の記録は動き続ける -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- 歩数計は歩数センサーのある端末でのみ意味があるが、
         センサーが無い端末では Health Connect にフォールバックするため required=false -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <application
        android:name=".StepsApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.StepsApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.StepsApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android 13 以下: Health Connect の権限説明を求められたときの受け口 -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14 以上: 同じく権限説明の受け口 -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>


        <receiver
            android:name=".widget.RingWidgetReceiver"
            android:exported="true"
            android:label="歩数リング">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ring" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidgetReceiver"
            android:exported="true"
            android:label="歩数と週グラフ">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week" />
        </receiver>

        <receiver
            android:name=".widget.SummaryWidgetReceiver"
            android:exported="true"
            android:label="からだのまとめ">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_summary" />
        </receiver>

        <receiver
            android:name=".widget.MonthWidgetReceiver"
            android:exported="true"
            android:label="月グラフ">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month" />
        </receiver>

        <service
            android:name=".live.StepCountingService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <receiver
            android:name=".work.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 共有画像だけを外部アプリに渡す。範囲は res/xml/file_paths.xml で
             キャッシュの share/ に限定してある -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
